# Configuracao do Claude Code Remote Control (servico claude-rc).
# Depois de editar: sudo systemctl restart claude-rc
DEVBOX_RC_NAME=devbox-kioshi-devops
DEVBOX_RC_DIR=$HOME/github
# same-dir | worktree | session
DEVBOX_RC_SPAWN=same-dir
# default | acceptEdits | auto | plan | dontAsk | bypassPermissions
DEVBOX_RC_PERMISSION_MODE=default
